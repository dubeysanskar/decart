# ---- site ----
NEXT_PUBLIC_SITE_URL=https://decart.co.in

# ---- database (Turso / libSQL) ----
# Leave TURSO_DATABASE_URL blank to run the catalogue straight from the static seed (read-only).
# URL looks like: libsql://<db-name>-<org>.turso.io   (`turso db show <name> --url`)
# Token from: `turso db tokens create <name>`
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ---- admin auth ----
# local dev: http://localhost:3000 — on Vercel this must be the live domain, https://decart.co.in
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
ADMIN_EMAIL=info@decartseatings.in
ADMIN_PASSWORD=              # hashed & seeded on first `npm run seed`, then remove

# ---- smtp ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
MAIL_FROM_NAME=DecArt Industries
MAIL_ROUTING_JSON={"default":["info@decartseatings.in"]}

# ---- smtp fallback ---- used only when Settings and SMTP_* above are missing or refuse a send
SMTP_FALLBACK_HOST=smtp.gmail.com
SMTP_FALLBACK_PORT=587
SMTP_FALLBACK_USER=
SMTP_FALLBACK_PASS=
SMTP_FALLBACK_FROM=

# ---- uploads ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_UNSIGNED_PRESET=

# ---- contact ----
NEXT_PUBLIC_WHATSAPP=919311942001

# ---- analytics (optional) ----
# Search Console -> Settings -> Ownership verification -> HTML tag: paste only the content="..." value
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_GA_ID=
